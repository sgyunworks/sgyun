# Owner Studio authentication. Use long, unique values in the deployment dashboard.
SGYUN_STUDIO_PASSWORD=
SGYUN_STUDIO_SESSION_SECRET=

# Optional in local development; required for production publishing.
# Use a fine-grained token limited to Contents write access for this repository.
SGYUN_GITHUB_TOKEN=
SGYUN_GITHUB_OWNER=sgyunworks
SGYUN_GITHUB_REPO=sgyun
SGYUN_GITHUB_BRANCH=main
